rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Custom functions for role checking
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() {
      return getRole() == 'admin';
    }
    function isProjectCoordinator() {
      return getRole() == 'project_coordinator';
    }
    function isMemberOfProject(projectId) {
      return request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.members;
    }
    
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    
    match /projects/{projectId} {
      allow read: if request.auth != null && (isAdmin() || isProjectCoordinator() || request.auth.uid in resource.data.members);
      allow create: if request.auth != null && (isAdmin() || isProjectCoordinator());
      allow update: if request.auth != null && (isAdmin() || isProjectCoordinator());
      allow delete: if request.auth != null && isAdmin();
    }
    
    match /portfolios/{portfolioId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (isAdmin() || isProjectCoordinator());
    }
    
    match /tasks/{taskId} {
      allow read: if request.auth != null && (isAdmin() || isProjectCoordinator() || isMemberOfProject(resource.data.projectId));
      allow write: if request.auth != null && (isAdmin() || isProjectCoordinator() || isMemberOfProject(request.resource.data.projectId));
    }
  }
}
